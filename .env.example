# Provider is explicit; never silently switch on errors.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# At most one Gemini item at a time; start requests at least 13 seconds apart.
GEMINI_MIN_INTERVAL_MS=13000
# SERVER ONLY. Never put these in js/, data/, docs/, or GitHub Pages.
OPENAI_API_KEY=
# Choose an account-available Responses model supporting strict JSON schema; freeze for evaluation.
OPENAI_MODEL=
# Generate a random team token of at least 32 characters, distribute privately, never a provider key.
DEMO2_ACCESS_TOKEN=
# Jev priority classifications are separate, user-triggered calls from Demo 1.
# The Jev key stays on the backend; the existing team token protects this route.
JEV_API_KEY=apikey_2213eee0e6ee728b4d3caf9c411d6dcba9d4_20b17b82adaf22655b7c378f6915aded08582fb6d467ce80d639183e010ba954
JEV_MODEL=jev-latest
# Explicit public analysis opt-in; keeps /api/models token-protected.
DEMO2_PUBLIC_DEMO=false
ALLOWED_ORIGINS=https://lazydonuts.github.io,http://127.0.0.1:4922,http://localhost:4922,http://127.0.0.1:4920
HOST=127.0.0.1
PORT=4922
